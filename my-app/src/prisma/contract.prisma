model User {
  id        String             @id @default(uuid())
  email     String             @unique
  username  String?
  posts     Post[]
  createdAt TimestamptzString  @default(now())
}

model Post {
  id        String             @id @default(uuid())
  title     String
  content   String?
  published Boolean            @default(false)
  author    User               @relation(fields: [authorId], references: [id])
  authorId  String
  createdAt TimestamptzString  @default(now())
}